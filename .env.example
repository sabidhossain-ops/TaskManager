# Copy this file to .env.local and fill in values from
# Supabase Dashboard -> Project Settings -> API.
#
# Only the PUBLIC anon key belongs here. It is safe in the browser
# because Row Level Security protects the data.
# NEVER put the service_role key in any VITE_ variable — it would be
# bundled into the public JavaScript.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
